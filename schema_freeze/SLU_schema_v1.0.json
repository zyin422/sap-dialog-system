{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "title": "SAP Spoken Language Understanding (SLU) Benchmark Schema",
  "description": "29 Canonical Tools across 10 Functional Domains for Dysarthric Spoken Dialog System Evaluation",
  "domains": {
    "accessibility": [
      "accessibility_dictation_toggle",
      "accessibility_ui_scale"
    ],
    "calendar_alarm": [
      "alarm_manage",
      "schedule_manage"
    ],
    "communication": [
      "call_make",
      "call_manage",
      "messages_manage",
      "email_manage"
    ],
    "general_qa": [
      "qa_search",
      "weather_query",
      "device_find",
      "order_manage"
    ],
    "health": [
      "health_medication_reminder",
      "health_refill_query",
      "health_info_query"
    ],
    "maps_places": [
      "maps_route",
      "places_search",
      "reservations_manage"
    ],
    "media": [
      "media_play",
      "media_search",
      "media_control",
      "media_volume"
    ],
    "notes_memory": [
      "lists_manage",
      "memory_note_manage"
    ],
    "smart_home": [
      "iot_device_power",
      "iot_device_adjust",
      "iot_sensor_query"
    ],
    "transport": [
      "rideshare_book",
      "transit_lookup"
    ]
  },
  "tools": [
    {
      "name": "accessibility_dictation_toggle",
      "domain": "accessibility",
      "description": "Toggle speech-to-text dictation listening state for motor-impaired users.",
      "parameters": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "enable",
              "disable"
            ],
            "description": "Dictation listening state toggle"
          }
        },
        "required": [
          "state"
        ]
      }
    },
    {
      "name": "accessibility_ui_scale",
      "domain": "accessibility",
      "description": "Adjust visual interface zoom, text font size, or high-contrast display for visual impairment.",
      "parameters": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "in",
              "out"
            ],
            "description": "Zoom or scaling direction"
          },
          "ui_element": {
            "type": "string",
            "enum": [
              "zoom",
              "text_size",
              "high_contrast",
              "screen"
            ],
            "description": "Interface element scaled"
          }
        },
        "required": [
          "direction"
        ]
      }
    },
    {
      "name": "alarm_manage",
      "domain": "calendar_alarm",
      "description": "Set, cancel, snooze, or query wake-up alarms and countdown timers.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "set",
              "cancel",
              "query",
              "snooze"
            ],
            "description": "Alarm action"
          },
          "time": {
            "type": "string",
            "description": "Clock time or timer countdown duration (e.g. 7 am, 15 minutes)"
          },
          "date": {
            "type": "string",
            "description": "Alarm date (e.g. tomorrow)"
          },
          "general_frequency": {
            "type": "string",
            "enum": [
              "daily",
              "weekdays",
              "weekends",
              "weekly",
              "monthly"
            ],
            "description": "Alarm recurrence frequency (populated only when explicit recurrence tokens like daily, weekdays, or every... are uttered)"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "schedule_manage",
      "domain": "calendar_alarm",
      "description": "Create, reschedule, cancel, or inspect calendar events, appointments, and task reminders.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "delete",
              "query",
              "update"
            ],
            "description": "Schedule operation"
          },
          "title": {
            "type": "string",
            "description": "Event title, appointment name, generic event noun (e.g. meeting, call, appointment), or reminder task description"
          },
          "date": {
            "type": "string",
            "description": "Calendar day or relative date expression (e.g. tomorrow, friday, september 18th)"
          },
          "time": {
            "type": "string",
            "description": "Clock time or meal timestamp (e.g. 11:30, 2 pm, tonight)"
          },
          "person": {
            "type": "string",
            "description": "Attendee or participant name"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "call_make",
      "domain": "communication",
      "description": "Place outgoing voice or video telephone calls to a contact or phone number.",
      "parameters": {
        "type": "object",
        "properties": {
          "recipient_name": {
            "type": "string",
            "description": "Recipient person or business being called"
          },
          "phone_number": {
            "type": "string",
            "description": "Telephone digits"
          }
        }
      }
    },
    {
      "name": "call_manage",
      "domain": "communication",
      "description": "Manage active incoming or connected telephony calls.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "answer",
              "decline",
              "hang_up",
              "mute",
              "unmute",
              "redial"
            ],
            "description": "Telephony control action"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "messages_manage",
      "domain": "communication",
      "description": "Send, read, or reply to SMS or instant chat messages.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "send",
              "read",
              "reply"
            ],
            "description": "Messaging action"
          },
          "recipient": {
            "type": "string",
            "description": "Recipient contact name or phone number"
          },
          "message_body": {
            "type": "string",
            "description": "Dictated message text"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "email_manage",
      "domain": "communication",
      "description": "Compose, send, search, or read electronic mail messages.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "send",
              "read",
              "search"
            ],
            "description": "Email action"
          },
          "recipient": {
            "type": "string",
            "description": "Recipient email address or contact name"
          },
          "date": {
            "type": "string",
            "description": "Date filter for email lookup"
          },
          "message_body": {
            "type": "string",
            "description": "Dictated body content"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "qa_search",
      "domain": "general_qa",
      "description": "Open-domain factual web queries, encyclopedia knowledge, recipes, news briefings, stock prices, and math calculations (excluding commercial business hours which route to places_search).",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Core factual search query, stripped of conversational carrier prefixes (e.g. 'can you look up', 'tell me', 'show me if', 'search google for')"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "weather_query",
      "domain": "general_qa",
      "description": "Check meteorological weather conditions, forecasts, and temperature.",
      "parameters": {
        "type": "object",
        "properties": {
          "place_name": {
            "type": "string",
            "description": "Target geographic city, state, or region"
          },
          "date": {
            "type": "string",
            "description": "Forecast date (e.g. today, tomorrow, this weekend)"
          },
          "weather_aspect": {
            "type": "string",
            "description": "Specific meteorological condition (e.g. rain, snow, temperature)"
          }
        }
      }
    },
    {
      "name": "device_find",
      "domain": "general_qa",
      "description": "Trigger an audible acoustic ping to locate a misplaced hardware device.",
      "parameters": {
        "type": "object",
        "properties": {
          "device_type": {
            "type": "string",
            "description": "Target misplaced device noun phrase (e.g. phone, ipad)"
          }
        }
      }
    },
    {
      "name": "order_manage",
      "domain": "general_qa",
      "description": "E-commerce parcel tracking, delivery status, and order returns.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "track",
              "cancel",
              "return",
              "status"
            ],
            "description": "Parcel/order management action"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "health_medication_reminder",
      "domain": "health",
      "description": "Schedule prescription medication or supplement dosage reminders.",
      "parameters": {
        "type": "object",
        "properties": {
          "medication": {
            "type": "string",
            "description": "Prescription drug or supplement name"
          },
          "time": {
            "type": "string",
            "description": "Intake time or meal reference"
          }
        },
        "required": [
          "medication"
        ]
      }
    },
    {
      "name": "health_refill_query",
      "domain": "health",
      "description": "Inquire about remaining prescription refills or pharmacy status.",
      "parameters": {
        "type": "object",
        "properties": {
          "medication": {
            "type": "string",
            "description": "Prescription drug name"
          }
        },
        "required": [
          "medication"
        ]
      }
    },
    {
      "name": "health_info_query",
      "domain": "health",
      "description": "Inquire about clinical medication side effects, interactions, or dosage guidance.",
      "parameters": {
        "type": "object",
        "properties": {
          "medication": {
            "type": "string",
            "description": "Prescription drug name"
          },
          "info_type": {
            "type": "string",
            "enum": [
              "side_effects",
              "dosage",
              "interactions",
              "refill"
            ],
            "description": "Clinical inquiry type"
          }
        },
        "required": [
          "medication"
        ]
      }
    },
    {
      "name": "maps_route",
      "domain": "maps_places",
      "description": "Turn-by-turn driving directions, route distance, navigation, and traffic estimates.",
      "parameters": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "description": "Target geographic destination or arrival point (BaseNP stripped)"
          },
          "origin": {
            "type": "string",
            "description": "Starting geographic departure point for point-to-point queries (BaseNP stripped, e.g. in 'distance from Montreal to Brattleboro', origin is 'montreal, canada')"
          },
          "query_type": {
            "type": "string",
            "enum": [
              "directions",
              "distance",
              "traffic"
            ],
            "description": "Navigation query category (phrases like 'navigate to...' normalize to 'directions')"
          }
        },
        "required": [
          "destination"
        ]
      }
    },
    {
      "name": "places_search",
      "domain": "maps_places",
      "description": "Search local commercial venues, stores, operating hours/status (e.g. 'When is Bed, Bath and Beyond open until?'), and restaurants.",
      "parameters": {
        "type": "object",
        "properties": {
          "business_name": {
            "type": "string",
            "description": "Brand or venue title"
          },
          "business_type": {
            "type": "string",
            "description": "Commercial category (e.g. pharmacy, coffee shop)"
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "rating",
              "distance",
              "relevance"
            ],
            "description": "Result ranking preference. Spoken inquiries for 'nearby' venues (e.g. 'nearby cafes', 'closest starbucks') require 'distance'"
          }
        }
      }
    },
    {
      "name": "reservations_manage",
      "domain": "maps_places",
      "description": "Book, modify, or check table dining reservations at restaurants and venues.",
      "parameters": {
        "type": "object",
        "properties": {
          "business_name": {
            "type": "string",
            "description": "Restaurant or hospitality venue title"
          },
          "time": {
            "type": "string",
            "description": "Reservation timestamp"
          },
          "date": {
            "type": "string",
            "description": "Reservation calendar day"
          },
          "party_size": {
            "type": "string",
            "description": "Guest headcount"
          }
        },
        "required": [
          "business_name"
        ]
      }
    },
    {
      "name": "media_play",
      "domain": "media",
      "description": "Initiate playback of music tracks, albums, podcasts, radio stations, audiobooks, movies, or video streaming platforms (e.g. 'Open Hulu').",
      "parameters": {
        "type": "object",
        "properties": {
          "media_type": {
            "type": "string",
            "enum": [
              "music",
              "podcast",
              "radio",
              "audiobook",
              "movie",
              "tv_show"
            ],
            "description": "Media content format"
          },
          "title": {
            "type": "string",
            "description": "Track, album, show, or movie title"
          },
          "artist": {
            "type": "string",
            "description": "Musician, band, or host"
          },
          "service": {
            "type": "string",
            "description": "Streaming app or platform (e.g. hulu, paramount plus, spotify, netflix)"
          },
          "house_place": {
            "type": "string",
            "description": "Residential playback room"
          }
        }
      }
    },
    {
      "name": "media_search",
      "domain": "media",
      "description": "Search, browse, or recommend movies, shows, music, podcasts, or audiobooks without immediate playback.",
      "parameters": {
        "type": "object",
        "properties": {
          "media_type": {
            "type": "string",
            "enum": [
              "movie",
              "tv_show",
              "music",
              "podcast",
              "audiobook"
            ],
            "description": "Media category sought"
          },
          "person": {
            "type": "string",
            "description": "Actor, director, musician, or podcast host"
          },
          "genre": {
            "type": "string",
            "description": "Genre or mood classification (e.g. comedy, horror, rock)"
          },
          "title": {
            "type": "string",
            "description": "Franchise or title search string"
          }
        }
      }
    },
    {
      "name": "media_control",
      "domain": "media",
      "description": "Control active media playback state (pause, resume, stop, skip, fast-forward, rewind, like, dislike).",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              "stop",
              "next",
              "previous",
              "like",
              "dislike",
              "fast_forward",
              "rewind"
            ],
            "description": "Playback control action (normalize favorites/thumbs up to like)"
          },
          "duration": {
            "type": "string",
            "description": "Scrubbing offset or seek duration"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "media_volume",
      "domain": "media",
      "description": "Adjust, mute, unmute, or set audio output volume level.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "mute",
              "unmute",
              "set"
            ],
            "description": "Volume adjustment direction or state"
          },
          "change_amount": {
            "type": "string",
            "description": "Offset step or target absolute level"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "lists_manage",
      "domain": "notes_memory",
      "description": "Create, view, add items to, or remove items from shopping and to-do lists.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "add",
              "remove",
              "query"
            ],
            "description": "List action"
          },
          "item": {
            "type": "string",
            "description": "Item noun phrase or conjunction phrase"
          },
          "list_name": {
            "type": "string",
            "description": "Target list name"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "memory_note_manage",
      "domain": "notes_memory",
      "description": "Store or recall user personal notes, memos, and associative facts that lack a specific trigger date or time.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "store",
              "recall"
            ],
            "description": "Memory operation"
          },
          "key": {
            "type": "string",
            "description": "Associative subject/attribute key for X-is-Y relations (e.g. 'parking space', 'locker combination'). Omitted for unkeyed declarative clauses."
          },
          "value": {
            "type": "string",
            "description": "Verbatim fact content or full unkeyed declarative clause (e.g. '4412', 'we\\'re out of batteries')"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "iot_device_power",
      "domain": "smart_home",
      "description": "Discrete binary power control: turn smart appliances and lighting on or off. Also handles door lock actuation.",
      "parameters": {
        "type": "object",
        "properties": {
          "device_type": {
            "type": "string",
            "description": "Appliance, fixture, or hardware device noun phrase"
          },
          "state": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "description": "Target power/lock state (lock -> on, unlock -> off)"
          },
          "house_place": {
            "type": "string",
            "description": "Residential room location (separated from device_type)"
          }
        },
        "required": [
          "state"
        ]
      }
    },
    {
      "name": "iot_device_adjust",
      "domain": "smart_home",
      "description": "Adjust continuous smart device settings: brightness, temperature, color, or speed.",
      "parameters": {
        "type": "object",
        "properties": {
          "device_type": {
            "type": "string",
            "description": "Target hardware appliance"
          },
          "setting": {
            "type": "string",
            "enum": [
              "brightness",
              "temperature",
              "color",
              "speed"
            ],
            "description": "Target adjustment attribute"
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Relative adjustment direction"
          },
          "value": {
            "type": "string",
            "description": "Target absolute setting with units (e.g. 72 degrees, 375 degrees)"
          }
        }
      }
    },
    {
      "name": "iot_sensor_query",
      "domain": "smart_home",
      "description": "Inquire about indoor environmental sensors (temperature, motion) or state inspection of contact/lock sensors.",
      "parameters": {
        "type": "object",
        "properties": {
          "sensor_type": {
            "type": "string",
            "enum": [
              "temperature",
              "motion",
              "lock",
              "contact"
            ],
            "description": "Sensor modality queried"
          },
          "device_type": {
            "type": "string",
            "description": "Hardware device target (e.g. front door)"
          },
          "room": {
            "type": "string",
            "description": "Room or residential zone"
          }
        }
      }
    },
    {
      "name": "rideshare_book",
      "domain": "transport",
      "description": "Order or hail a taxi, cab, or rideshare vehicle.",
      "parameters": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "description": "Drop-off location (BaseNP stripped)"
          }
        }
      }
    },
    {
      "name": "transit_lookup",
      "domain": "transport",
      "description": "Check schedules or lookup tickets for public transit, trains, buses, subways, and flights.",
      "parameters": {
        "type": "object",
        "properties": {
          "transit_type": {
            "type": "string",
            "enum": [
              "train",
              "bus",
              "flight"
            ],
            "description": "Transportation modality"
          },
          "destination": {
            "type": "string",
            "description": "Arrival stop, station, or city"
          },
          "route_or_station": {
            "type": "string",
            "description": "Public transit line name, station, or commercial airline carrier (e.g. 'red line', 'penn station', 'southwest airlines', 'jet blue')"
          },
          "time": {
            "type": "string",
            "description": "Departure or arrival timestamp (clock time only, e.g. '7 am', 'noon'; flight modifiers like 'non-stop' or 'round-trip' are outside tokens and must NOT be put here)"
          }
        }
      }
    }
  ]
}