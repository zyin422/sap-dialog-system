{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAP Spoken Dialog Benchmark Schema Registry",
  "description": "Canonical taxonomy for evaluating Tool Selection (TS) and Parameter Filling (PF) on dysarthric speech across 10 functional domains and 30 canonical tools with typed JSON Schema parameter definitions.",
  "extraction_guidelines": {
    "span_rule": "Extract bare nominal entities (BaseNP). Strictly exclude leading prepositions (at, with, on, in, to, for) and determiners (a, an, the).",
    "wake_words": "Treat wake words (hey siri, alexa, hey google, cortana, hey facebook) as Outside (O) tokens. Never extract wake words into slot parameters.",
    "normalization": "Verbatim substring match from the user transcript in lowercase."
  },
