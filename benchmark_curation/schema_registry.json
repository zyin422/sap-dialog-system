{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAP Spoken Dialog Benchmark Schema Registry",
  "description": "Standardized canonical taxonomy for evaluating Tool Selection (TS) and Parameter Filling (PF) on dysarthric speech. Sourced from Amazon MASSIVE/SLURP with clinical and accessibility extensions.",
  "ontology_sources": {
    "base": "Amazon MASSIVE / SLURP (18 domains, 60 intents, 55 slot types)",
    "extensions": [
      {
        "domain": "health",
        "rationale": "Captures dysarthria-specific clinical prescriptions and dosage management present in the SAP recording protocol.",
        "intents": {
          "health_refill_query": {
            "description": "Inquire about remaining prescription refills or pharmacy status.",
            "allowed_slots": ["medication"]
          },
          "health_medication_reminder": {
            "description": "Schedule medication intake or dosage reminders.",
            "allowed_slots": ["medication", "time"]
          }
        }
      },
      {
        "domain": "accessibility",
        "rationale": "Captures assistive UI voice controls essential for speakers with motor-speech and physical impairments.",
        "intents": {
          "accessibility_ui_scale": {
            "description": "Modify UI scale or text size.",
            "allowed_slots": ["ui_element", "direction"]
          },
          "accessibility_dictation_toggle": {
            "description": "Enable or disable hands-free voice dictation listening.",
            "allowed_slots": ["state"]
          }
        }
      }
    ]
  },
